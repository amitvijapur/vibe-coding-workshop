# Local Python environments and caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
/tasks/
.DS_Store
Thumbs.db

# Local credentials and environment configuration.
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json
.aws/
.ssh/

# Generated output: publish only the two current presentation files.
/out/*
!/out/vibe-coding-workshop.html
!/out/vibe-coding-workshop.pptx

# Generated gradient backgrounds and machine-specific font configuration.
/assets/*.jpg
/assets/fonts.conf

# Download and extraction leftovers from the original asset collection.
/assets/v[0-9]*/

# Editor scratch and Office lock files.
*.swp
*.swo
~$*
